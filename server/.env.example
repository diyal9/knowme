# HTTP and admin authentication
KNOWME_ADMIN_LISTEN=:8020
KNOWME_ADMIN_KEY=replace-with-a-long-random-key
KNOWME_SESSION_SECRET=replace-with-a-different-long-random-secret
KNOWME_ADMIN_SEED_USER=admin
KNOWME_ADMIN_SEED_PASSWORD=replace-before-first-start

# SQLite is the supported production path for the first release.
KNOWME_DB_DRIVER=sqlite
KNOWME_DB_DSN=./data/knowme.db
KNOWME_RATE_LIMIT_RPS=20

# Provider keys are server-only secrets; never put them in the client or database.
KNOWME_OPENAI_API_KEY=
KNOWME_OPENAI_BASE_URL=https://api.openai.com/v1
KNOWME_DASHSCOPE_API_KEY=
KNOWME_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
