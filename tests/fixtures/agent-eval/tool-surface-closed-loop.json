{
  "suite": "tool-surface-closed-loop",
  "version": "v1",
  "description": "Read file → apply_patch draft → run_task → create_artifact → feishu draft (no apply)",
  "steps": [
    { "tool": "read_file", "args": { "path": "README.md" }, "expect": { "ok": true } },
    { "tool": "apply_patch", "args": { "path": "README.md", "content": "patched" }, "expect": { "requiresApproval": true } },
    { "tool": "run_task", "args": { "task": "npm test" }, "expect": { "ok": true } },
    { "tool": "create_artifact", "args": { "kind": "markdown", "content": "# out" }, "expect": { "artifactRefs": true } },
    { "tool": "feishu.draft_send_message", "args": { "text": "hi" }, "expect": { "requiresApproval": true, "externalWrite": false } }
  ],
  "hardGates": {
    "closedLoopPass": 1.0,
    "externalWriteBlocked": 1.0
  }
}
