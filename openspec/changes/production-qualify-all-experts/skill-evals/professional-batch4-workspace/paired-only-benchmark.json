        {
          "text": "\u660e\u786e6\u540d\u72ec\u7acb\u53c2\u4e0e\u8005\u30019\u6761\u6750\u6599\u8bb0\u5f55\uff0cU1\u7684I1/I2/T1\u4e0d\u80fd\u53d8\u62103\u4eba\uff0cU5\u7684I6/T2\u4e0d\u80fd\u53d8\u62102\u4eba\uff1b\u82e5\u62a5\u544a\u72b6\u6001\u4e0d\u786e\u5b9a\u4e3b\u9898\u6bd4\u4f8b\uff0c\u4ee5U1/U2\u4e24\u540d\u4e0d\u540c\u53c2\u4e0e\u8005\u4f5c2/6\u6837\u672c\u63cf\u8ff0\uff0c\u800c\u4e0d\u662f3/9\u7b49\u8bb0\u5f55\u5360\u6bd4\u5192\u5145\u4eba\u6570\u6216\u603b\u4f53\u6bd4\u4f8b\u3002",
          "passed": false,
          "evidence": "\u00a71\u53ca\u00a75\u5c06\u539f\u59cb\u6750\u6599\u5199\u4e3a8\u6761\uff086\u8bbf\u8c08\u8bb0\u5f55+2\u5de5\u5355\uff09\u3002\u72ec\u7acb\u6838\u7b97\u4e3aI1\u81f3I7\u4e03\u6761\u8bbf\u8c08\u7247\u6bb5\u52a0T1/T2\u51719\u6761\uff1b\u516d\u4eba\u63a5\u53d7\u8bbf\u8c08\u4e0d\u7b49\u4e8e\u516d\u6761\u8bbf\u8c08\u8bb0\u5f55\u3002\u53bb\u6389\u4e24\u6761\u9010\u5b57\u590d\u5236\u540e\u4fdd\u75597\u4e2a\u4e0d\u540c\u7247\u6bb5\uff1b\u82e5\u6309\u540c\u4e00\u4e8b\u4ef6\u5408\u5e76I1/I2\u9700\u53e6\u8bf4\u660e\uff0c\u4e0d\u80fd\u4ee5\u20186\u6761\u72ec\u7acb\u8bc1\u636e\u2019\u541e\u6389I2\u8865\u5145\u7684\u4e0d\u786e\u5b9a\u6027\u3002\u516d\u540d\u53c2\u4e0e\u8005\u30012/6\u53caT1/T2\u4e0d\u589e\u4eba\u6570\u662f\u6b63\u786e\u70b9\uff0c\u4f46\u660e\u786e\u8bb0\u5f55\u6570\u8981\u6c42\u5931\u8d25\u3002"
        },
        {
          "text": "\u81f3\u5c11\u628a\u72b6\u6001\u53ef\u7406\u89e3\u6027/\u91cd\u590d\u64cd\u4f5c\u987e\u8651\u5173\u8054I1/I2/I3\uff0c\u628a\u5f52\u6863\u5bfc\u51fa\u4efb\u52a1\u5173\u8054I5\uff0c\u628a\u5de5\u4f5c\u533a\u8fb9\u754c\u4fe1\u4efb\u98ce\u9669\u5173\u8054I6\uff0c\u5e76\u4fdd\u7559\u5404\u81ea\u91c7\u96c6\u4e0a\u4e0b\u6587\uff1b\u539f\u8bdd\u4e0d\u88ab\u6da6\u8272\u6210\u65b0\u5f15\u8bed\uff0c\u4e0d\u628aU1\u5237\u65b0\u540e\u51fa\u7ed3\u679c\u89e3\u91ca\u4e3a\u5df2\u8bc1\u660e\u5237\u65b0\u4fee\u590d\u6545\u969c\u3002",
          "passed": true,
          "evidence": "\u00a72\u4e3b\u9898A\u5173\u8054I1/I2/I3\uff0c\u4e3b\u9898C\u5173\u8054I5\u53ca\u8bf1\u5bfc\u63d0\u95ee\uff0c\u4e3b\u9898B\u5173\u8054I6/T2\u53ca\u505c\u6b62\u9884\u89c8\uff1b\u539f\u8bdd\u4e3a\u771f\u5b9e\u539f\u53e5\u6216\u672a\u6539\u53d8\u610f\u4e49\u7684\u8fde\u7eed\u6458\u5f55\u3002I2\u660e\u786e\u2018\u65e0\u6cd5\u5f52\u56e0\u2019\uff0c\u6ca1\u6709\u5199\u6210\u5237\u65b0\u5df2\u8bc1\u660e\u4fee\u590d\u6545\u969c\u3002\u9996\u6b21\u4f7f\u7528\u3001\u7ba1\u7406\u5458\u5f52\u6863\u4e0e\u7591\u4f3c\u8fb9\u754c\u7ebf\u7d22\u7684\u4e0a\u4e0b\u6587\u5f97\u5230\u4fdd\u7559\u3002\u00a73\u8fc7\u5f3a\u56e0\u679c\u4e0e\u4ef7\u503c\u6392\u5e8f\u53e6\u5728\u65ad\u8a003/4\u53caclaims\u8ba1\uff0c\u4e0d\u5c06\u6b63\u786e\u4e3b\u9898\u6620\u5c04\u62b9\u6389\u3002"
        },
        {
          "text": "\u4fdd\u7559I4\u6e05\u6670\u65ad\u7f51\u63d0\u793a\u4e14\u5e73\u65f6\u591f\u7528\u3001I7\u65e5\u5e38\u6ee1\u610f\u4e14\u4e0d\u9700\u8981\u5bfc\u51fa\u7684\u53cd\u4f8b\uff0c\u533a\u5206\u65b0\u6210\u5458/\u7ba1\u7406\u5458\u548c\u4e0d\u540c\u6545\u969c\u60c5\u666f\uff1b\u8bf4\u660e\u4ed8\u8d39\u5185\u6d4b\u81ea\u9009\u3001\u7ba1\u7406\u5458\u504f\u591a\u3001\u65e0\u6d41\u5931\u6837\u672c\u53caI5\u8bf1\u5bfc\u63d0\u95ee\u9650\u5236\uff0c\u4e0d\u80fd\u58f0\u79f0\u603b\u4f53\u504f\u597d\u3001\u9971\u548c\u6216\u56e0\u679c\u6210\u7acb\u3002",
          "passed": false,
          "evidence": "\u867d\u5728\u00a71\u53ca\u00a72\u4fdd\u7559\u89d2\u8272\u5dee\u5f02\u3001\u81ea\u9009\u5185\u6d4b\u3001\u7ba1\u7406\u5458\u504f\u591a\u3001\u7f3a\u5931\u4eba\u7fa4\u3001I5\u8bf1\u5bfc\u63d0\u95ee\u548cI4/I7\u53cd\u4f8b\uff0c\u00a74\u5374\u89c4\u5b9a\u2018\u82e5\u22652/2\u4ecd\u51fa\u73b0\u65e0\u53cd\u9988\u7126\u8651\u2192\u4e3b\u9898A\u5177\u666e\u904d\u6027\u2019\uff0c\u4ee5\u53ca\u4e24\u4eba\u65e0\u62b1\u6028\u5373\u53ef\u5224\u5b9a\u539f\u5185\u6d4b\u81ea\u9009\u62e9\u653e\u5927\u95ee\u9898\u3002\u00a73\u8fd8\u79f0\u53cd\u9988\u7f3a\u5931\u4e3a\u9996\u7a0b\u2018\u6700\u5927\u6469\u64e6\u70b9\uff0c\u76f4\u63a5\u5bfc\u81f4\u2019\u6210\u672c\u3002\u672b\u5c3e\u5c0f\u6837\u672c\u514d\u8d23\u58f0\u660e\u4e0d\u80fd\u6d88\u9664\u6b63\u6587/\u7814\u7a76\u5224\u636e\u4e2d\u7684\u666e\u904d\u6027\u4e0e\u539f\u56e0\u5347\u7ea7\u3002\u672a\u6765\u6761\u4ef6\u5f0f\u63a8\u65ad\u4e5f\u9700\u6709\u6548\uff0c\u4e0d\u5c06\u5b83\u8bef\u62a5\u4e3a\u5df2\u7ecf\u5b8c\u6210\u4e86\u65b0\u7814\u7a76\u3002"
        },
        {
          "text": "\u5bf9\u6279\u91cf\u5bfc\u51fa\u662f\u5426\u72ec\u5360\u8fed\u4ee3\u7ed9\u6709\u4f9d\u636e\u7684\u6709\u6761\u4ef6\u5224\u65ad\uff0c\u533a\u5206\u4e00\u4eba\u5f52\u6863\u9700\u6c42\u4e0e\u8d2d\u4e70\u6743\u9650\u672a\u77e5\uff1b\u5bf9U5\u5355\u4eba\u9ad8\u6f5c\u5728\u5f71\u54cd\u7ed9\u6838\u9a8c\u4f18\u5148\u7ea7\u800c\u975e\u5ba3\u79f0\u5df2\u6cc4\u6f0f\u6216\u56e0\u4f4e\u9891\u5ffd\u7565\uff0c\u673a\u4f1a/\u5efa\u8bae\u4e2d\u7684\u6536\u76ca\u4e0e\u539f\u56e0\u4e5f\u4e0d\u5f97\u8865\u9020\u3002",
          "passed": false,
          "evidence": "\u00a73\u2018\u4e0d\u5efa\u8bae\u72ec\u5360\u8fed\u4ee3\u2019\u548c\u8981\u6c42\u9a8c\u8bc1\u5bfc\u51fa\u9891\u6b21/\u8017\u65f6\u5177\u6709\u4f9d\u636e\uff0cU4\u975e\u8d2d\u4e70\u51b3\u7b56\u8005\u3001U5\u5355\u4eba\u9ad8\u5f71\u54cd\u5f85\u6838\u67e5\u4e5f\u88ab\u8bc6\u522b\u3002\u4f46\u673a\u4f1a\u8868\u5c06\u73b0\u8c61\u5199\u4e3a\u2018\u6700\u5927\u6469\u64e6\u70b9\uff0c\u76f4\u63a5\u5bfc\u81f4\u2026\u6210\u672c\u2019\u3001\u5f03\u7528\u9884\u89c8\u2018\u8868\u660e\u4fe1\u4efb\u8106\u5f31\u6027\u9ad8\u4e8e\u6548\u7387\u8bc9\u6c42\u2019\uff0c\u6ca1\u6709\u6bd4\u8f83\u6216\u56e0\u679c\u8bc1\u636e\u3002\u00a74\u82e5\u4e00\u6b21\u4e0d\u53ef\u590d\u73b0\u4e14\u62c5\u5fe7\u6015\u770b\u9519\u4fbf\u6309\u8fb9\u7f18case\u964d\u7ea7\uff0c\u4f1a\u628a\u6838\u9a8c\u8986\u76d6\u4e0d\u8db3\u53d8\u6210\u98ce\u9669\u4f4e\u7684\u4f9d\u636e\u3002\u5931\u8d25\u4e0d\u5728\u6682\u7f13\u5bfc\u51fa\u8fd9\u4e00\u5408\u7406\u4e3b\u89c2\u9009\u62e9\uff0c\u800c\u5728\u7406\u7531\u548c\u540e\u7eed\u53d6\u820d\u8d8a\u8fc7\u8bc1\u636e\u3002"
        },
        {
          "text": "\u540e\u7eed\u7814\u7a76\u5728\u6700\u591a6\u4e2a\u540d\u989d\u5185\u7ed9\u51fa\u5bf9\u8c61\u9009\u62e9\u3001\u4e2d\u6027\u95ee\u6cd5\u6216\u884c\u4e3a\u89c2\u5bdf\u3001\u53ef\u533a\u5206\u66ff\u4ee3\u89e3\u91ca\u7684\u8bb0\u5f55\u9879\u53ca\u4f1a\u6539\u53d8\u5efa\u8bae\u7684\u7ed3\u679c\uff1b\u81f3\u5c11\u9a8c\u8bc1\u72b6\u6001\u7406\u89e3\u4e0e\u771f\u5b9e\u7b49\u5f85/\u6545\u969c\u7684\u533a\u522b\uff0c\u4ee5\u53ca\u5de5\u4f5c\u533a\u9884\u89c8\u8fb9\u754c\u73b0\u8c61\uff0c\u4e0d\u53ea\u95ee\u60f3\u8981\u54ea\u4e9b\u529f\u80fd\uff0c\u4e0d\u865a\u6784\u5df2\u62db\u52df/\u5df2\u9a8c\u8bc1\u3002",
          "passed": false,
          "evidence": "\u540d\u989d2+2+1+1\u22646\uff0c\u4e14\u6709\u4efb\u52a1\u3001\u5bf9\u8c61\u53ca\u4e2d\u6027\u95ee\u9898\uff1b\u4f46\u65b0\u6210\u5458\u53ea\u8bb0\u5f55\u70b9\u51fb/\u6c42\u52a9/\u603b\u65f6\u957f/\u56f0\u60d1\uff0c\u6ca1\u6709\u5b9e\u9645\u8bf7\u6c42\u72b6\u6001\u3001\u7b49\u5f85/\u9519\u8bef\u4e8b\u4ef6\u4e0e\u884c\u4e3a\u65f6\u95f4\u7684\u5bf9\u7167\uff0c\u4e0d\u80fd\u533a\u5206\u771f\u5b9e\u7b49\u5f85/\u6545\u969c\u4e0e\u72b6\u6001\u7406\u89e3\u30022/2\u666e\u904d\u6027\u30010/2\u5f52\u56e0\u504f\u5dee\u3001\u4e00\u6b21\u4e0d\u53ef\u590d\u73b0\u964d\u7ea7\u90fd\u662f\u4e0d\u5145\u5206\u7684\u5224\u636e\u3002\u6d4b\u8bd5\u73af\u5883\u672a\u660e\u786e\u5408\u6210\u5de5\u4f5c\u533a\u5185\u5bb9\uff1b\u4ec5\u6f14\u793a\u65e7\u5bfc\u51fa\u6d41\u7a0b\u7684\u8017\u65f6\u4e5f\u4e0d\u80fd\u76f4\u63a5\u6d4b\u51fa\u6279\u91cf\u5bfc\u51fa\u6708\u5747\u8282\u7701\u91cf\uff0c\u5374\u4ee5<2\u5c0f\u65f6\u2018\u5f7b\u5e95\u6392\u9664\u2019\u72ec\u5360\u8fed\u4ee3\u3002\u5efa\u8bae\u9608\u503c\u53ef\u63d0\u51fa\uff0c\u4f46\u9700\u8981\u5f85\u51b3\u7b56\u53e3\u5f84\u53ca\u80fd\u5b9e\u9645\u89c2\u6d4b\u7684\u6bd4\u8f83\uff0c\u800c\u975e\u628a\u4efb\u610f\u9608\u503c\u5f53\u8bc1\u660e\u3002"
