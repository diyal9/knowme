{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "noCheck": true
  },
  "include": ["src/lib/**/*.ts", "src/main/**/*.ts", "src/ipc/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
