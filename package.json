{
  "name": "knowme",
  "version": "0.3.0",
  "description": "知我 KnowMe — AI 知识工作台 / 工作伙伴 Agent",
  "license": "MIT",
  "author": "aispace",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && electron-builder",
    "build:win": "npm run prebuild && electron-builder --win --x64",
    "build:mac": "npm run prebuild && electron-builder --mac --x64 --arm64",
    "build:dir": "npm run prebuild && electron-builder --dir",
    "publish:win": "npm run prebuild && electron-builder --win --x64 --publish always",
    "publish:mac": "npm run prebuild && electron-builder --mac --x64 --arm64 --publish always",
    "smoke:release": "node scripts/release-smoke.js dist-release",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/lint.js && node scripts/check-script-scope.js",
    "harness:check": "node .cursor/scripts/harness.js check",
    "harness:preflight": "node .cursor/scripts/harness.js preflight",
    "harness:gate": "node .cursor/scripts/harness.js gate",
    "harness:doctor": "node .cursor/scripts/harness.js doctor",
    "kb:lint": "node scripts/okf-lint.js",
    "kb:export": "node scripts/okf-export.js",
    "kb:import": "node scripts/okf-import.js",
    "memory:path": "python -X utf8 -c \"import sys; sys.path.insert(0,'.cursor/hooks'); import memory_paths as m; print(m.memory_root())\"",
    "memory:bootstrap": "python -X utf8 .cursor/hooks/memory_rollup_llm.py bootstrap",
    "workbench:sync": "node scripts/sync-workbench-workflows.js",
    "workbench:bootstrap": "node scripts/workbench-bootstrap-cli.js",
    "test:workbench-clean-env": "node scripts/workbench-clean-env-e2e.js",
    "test:daemon-e2e": "node scripts/daemon-live-e2e.js"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "marked": "^18.0.6"
  }
}
