{
  "schemaVersion": 2,
  "id": "feishu-meeting-summary",
  "kind": "skill",
  "name": "会议总结",
  "version": "1.0.0",
  "dependencies": [{ "id": "feishu", "kind": "connector", "required": true }],
  "permissions": { "tools": ["feishu.meeting_candidates", "feishu.meeting_read"] },
  "metadata": {
    "knowme": {
      "experience": {
        "tasks": [{
          "id": "meetingSummary",
          "title": "会议总结",
          "subtitle": "为我总结最近三天的会议",
          "icon": "check",
          "group": "office-core",
          "modes": ["general"],
          "surfaces": ["empty", "quick-menu"],
          "prompt": "请为我做会议总结。",
          "preflight": {
            "type": "connector-auth",
            "connector": "feishu",
            "message": "要做会议总结，我得先连上飞书读取你的会议记录。请到「设置 → 连接器」授权飞书（user 身份）后，再点一次「会议总结」。"
          },
          "requiredTools": ["feishu.meeting_candidates", "feishu.meeting_read"],
          "templateVars": { "days": 3 }
        }]
      }
    }
  }
}
