    "network": true,
    "write": true,
    "externalWrite": true
  },
  "inputs": ["飞书表格链接或目标标识", "结构化数据与经用户确认的字段映射"],
  "outputs": ["写入预览", "经确认后的写入回执与失败项"],
  "risk": { "level": "high", "reasons": ["会写入外部飞书表格", "必须在 preview 后获得用户确认"] },
  "provenance": { "source": "curated", "trust": "bundled", "ref": "skills/lark-sheet-fill" }
