{
  "schemaVersion": 3,
  "id": "crawl4ai-expert",
  "kind": "expert",
  "name": "Crawl4AI专家",
  "description": "完全基于 Crawl4AI 完成网页抓取、清洗与结构化抽取的专业工作伙伴",
  "version": "1.0.0",
  "dependencies": [
    {
      "id": "crawl4ai",
      "kind": "skill",
      "required": true
    }
  ],
  "permissions": {
    "connectors": {
      "allowedConnectorIds": []
    },
    "tools": {
      "allowlist": ["run_skill_script"]
    },
    "network": true,
    "write": true,
    "externalWrite": false
  },
  "inputs": [
    "目标 URL 或 URL 列表",
    "输出形态（Markdown / JSON / Schema）与是否需要等待选择器"
  ],
  "outputs": [
    "带来源 URL 的抓取正文或结构化结果",
    "失败诊断与可执行修复建议"
  ],
  "risk": {
    "level": "medium",
    "reasons": ["会启动无头浏览器访问用户指定网页"]
  },
  "provenance": {
    "source": "curated",
    "trust": "bundled",
    "ref": "experts/crawl4ai-expert"
  },
  "metadata": {
    "knowme": {
      "execution": {
        "strategy": "sop-first",
        "deliverables": [
          {
            "id": "output-1",
            "title": "带来源 URL 的抓取正文或结构化结果",
            "type": "answer",
            "required": true
          },
          {
            "id": "output-2",
            "mergeInto": "output-1",
            "title": "失败诊断与可执行修复建议",
            "type": "answer",
            "required": true
          }
        ],
        "routes": [
          {
            "id": "crawl-markdown",
            "default": true,
            "skillId": "crawl4ai",
            "requiredTools": ["run_skill_script"],
            "toolAllowlist": ["run_skill_script"],
            "description": "用 Crawl4AI 抓取页面并交付 Markdown 或结构化结果。",
            "qualityReview": {
              "enabled": true,
              "criteria": [
                "正文必须来自本轮 crawl4ai / crwl / scripts 回执，不能用模型记忆或搜索摘要冒充。",
                "每条交付内容保留来源 URL；失败项必须写明错误类型与下一步。",
                "未实际抓取成功时不得声称已完成抓取或已获得完整页面。"
              ]
            }
          }
        ],
        "qualityReview": {
          "enabled": true,
          "criteria": [
            "只使用 crawl4ai 技能完成抓取；不得假装调用了未执行的脚本。",
            "关键字段、标题和正文与回执一致；截断与失败必须显式标注。",
            "依赖未安装或浏览器未就绪时进入可恢复阻塞，不编造结果。"
          ]
        }
      }
    }
  }
}
