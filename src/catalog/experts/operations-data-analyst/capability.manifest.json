{
  "schemaVersion": 3,
  "id": "operations-data-analyst",
  "kind": "expert",
  "name": "运营数据分析专家·数据靓仔",
  "description": "复刻 th-BI 的运营分析协作体验，统一完成手游指标口径、埋点校验、数数查数、经营归因、报告导出和飞书填表",
  "version": "1.0.0",
  "dependencies": [
    { "id": "th-bi-analytics-assistant", "kind": "skill", "required": true },
    { "id": "data-analysis-method", "kind": "skill", "required": true },
    { "id": "business-metrics-analysis", "kind": "skill", "required": true },
    { "id": "business-cause-analysis", "kind": "skill", "required": true },
    { "id": "business-insight-report", "kind": "skill", "required": true },
    { "id": "data-report-method", "kind": "skill", "required": true },
    { "id": "lark-sheet-fill", "kind": "skill", "required": true },
    { "id": "te-report-playwright-export", "kind": "skill", "required": true },
    { "id": "writing-polish", "kind": "skill", "required": false },
    { "id": "pango-data-mcp", "kind": "connector", "required": false },
    { "id": "thinkingdata-analysis-mcp", "kind": "connector", "required": false },
    { "id": "feishu", "kind": "connector", "required": false }
  ],
  "permissions": {
    "connectors": {
      "allowedConnectorIds": ["pango-data-mcp", "thinkingdata-analysis-mcp", "feishu"]
    },
    "tools": {
      "allowlist": [
        "search_knowledge",
        "calculate",
        "load_skill",
        "read_skill_resource",
        "run_skill_script",
        "mcp_load_pango_data_mcp",
        "mcp_load_thinkingdata_analysis_mcp",
        "mcp.pango_data_mcp.list_user_projects",
        "mcp.pango_data_mcp.list_events",
        "mcp.pango_data_mcp.list_event_properties",
        "mcp.pango_data_mcp.list_dimensions",
        "mcp.pango_data_mcp.get_dimension_info",
        "mcp.pango_data_mcp.get_requirement_buried_point",
        "mcp.thinkingdata_analysis_mcp.list_projects",
        "mcp.thinkingdata_analysis_mcp.build_event_analysis_qp",
        "mcp.thinkingdata_analysis_mcp.build_retention_analysis_qp",
        "mcp.thinkingdata_analysis_mcp.build_funnel_analysis_qp",
        "mcp.thinkingdata_analysis_mcp.build_prop_analysis_qp",
        "mcp.thinkingdata_analysis_mcp.query_adhoc",
        "mcp.thinkingdata_analysis_mcp.drilldown_users",
        "mcp.thinkingdata_analysis_mcp.list_reports",
        "mcp.thinkingdata_analysis_mcp.get_report_definition",
        "mcp.thinkingdata_analysis_mcp.query_report_data",
        "mcp.thinkingdata_analysis_mcp.list_dashboards",
        "mcp.thinkingdata_analysis_mcp.query_dashboard_report_data",
        "mcp.thinkingdata_analysis_mcp.list_events",
        "mcp.thinkingdata_analysis_mcp.list_properties",
        "feishu.query_bitable",
        "feishu.draft_bitable_record"
      ]
    },
    "network": true,
    "write": true,
    "externalWrite": true
  },
  "inputs": [
    "业务问题、目标项目和期望决策；实时查数还需明确时间范围",
    "可用的数据源、报表链接、字段说明或已知筛选条件"
  ],
  "outputs": [
    "附口径、筛选、证据、冲突、限制和建议的运营分析",
    "按需生成的 CSV 导出或飞书写入回执"
  ],
  "risk": {
    "level": "high",
    "reasons": ["可访问公司数据服务", "导出脚本会写入本地文件", "飞书填表属于外部写入且必须逐次确认"]
  },
  "provenance": {
    "source": "curated",
    "trust": "bundled",
    "ref": "experts/operations-data-analyst"
  },
  "metadata": {
    "knowledgeRefs": ["local-default"],
    "origin": {
      "project": "th-BI",
      "path": "D:/aiworkspace/th-BI",
      "agent": "th-bi-analytics-assistant"
    },
    "knowme": {
      "execution": {
        "strategy": "sop-first",
        "qualityReview": {
          "enabled": true,
          "criteria": [
            "项目、时间范围、筛选条件、分析单位、分子、分母、单位和观察成熟度完整且前后一致。",
            "盘古协议、OKF 口径、数数结果和用户陈述分别标注；冲突并列展示且未被静默裁决。",
            "区分事实、计算、相关观察、竞争解释和因果判断；建议强度不超过证据强度。",
            "任何导出或外部写入都有真实工具回执；未执行步骤保持待执行状态。"
          ]
        },
        "deliverables": [
          {
            "id": "operations-analysis",
            "title": "运营分析与可执行结论",
            "type": "answer",
            "required": true
          }
        ],
        "routes": [
          {
            "id": "knowledge-query",
            "label": "查口径 / 查知识",
            "description": "从 th-BI OKF 知识包查询指标定义、项目约定、埋点与 Playbook。",
            "default": true,
            "keywords": ["口径", "指标定义", "埋点", "枚举", "知识库", "怎么计算"],
            "toolAllowlist": ["search_knowledge", "read_skill_resource"],
            "requiredSkills": ["th-bi-analytics-assistant"]
          },
          {
            "id": "live-analysis",
            "label": "实时查数 / 异常分析",
            "description": "用数数 builder 生成查询并跑数，再完成口径对账、变化拆解和经营解释。",
            "keywords": ["查数", "DAU", "留存", "ARPU", "付费率", "漏斗", "趋势", "异常", "归因"],
            "requiredConnectorIds": ["thinkingdata-analysis-mcp"],
            "requiredTools": ["mcp.thinkingdata_analysis_mcp.query_adhoc"],
            "toolAllowlist": [
              "search_knowledge",
              "calculate",
              "mcp_load_thinkingdata_analysis_mcp",
              "mcp.thinkingdata_analysis_mcp.list_projects",
              "mcp.thinkingdata_analysis_mcp.build_event_analysis_qp",
              "mcp.thinkingdata_analysis_mcp.build_retention_analysis_qp",
              "mcp.thinkingdata_analysis_mcp.build_funnel_analysis_qp",
              "mcp.thinkingdata_analysis_mcp.build_prop_analysis_qp",
              "mcp.thinkingdata_analysis_mcp.query_adhoc",
              "mcp.thinkingdata_analysis_mcp.drilldown_users"
            ],
            "requiredSkills": ["th-bi-analytics-assistant", "data-analysis-method", "business-metrics-analysis", "business-cause-analysis"]
          },
          {
            "id": "event-governance",
            "label": "埋点 / OKF 治理",
            "description": "按盘古协议核验事件、属性、枚举和需求埋点，并对 OKF 冲突做只读诊断。",
            "keywords": ["盘古", "事件", "事件属性", "枚举", "埋点需求", "ingest", "lint", "冲突"],
            "toolAllowlist": [
              "search_knowledge",
              "mcp_load_pango_data_mcp",
              "mcp.pango_data_mcp.list_user_projects",
              "mcp.pango_data_mcp.list_events",
              "mcp.pango_data_mcp.list_event_properties",
              "mcp.pango_data_mcp.list_dimensions",
              "mcp.pango_data_mcp.get_dimension_info",
              "mcp.pango_data_mcp.get_requirement_buried_point"
            ],
            "requiredSkills": ["th-bi-analytics-assistant"]
          },
          {
            "id": "report-export",
            "label": "导出 TE 报表",
            "description": "调用源项目 Playwright CLI 脚本点击 TE 页面导出并保存 CSV。",
            "keywords": ["导出", "CSV", "TE 报表", "数数报表", "bi.forevernine.net"],
            "toolAllowlist": ["load_skill", "read_skill_resource", "run_skill_script"],
            "requiredSkills": ["te-report-playwright-export"]
          },
          {
            "id": "sheet-fill",
            "label": "飞书填表",
            "description": "对已确认的数据与字段映射做预览，确认后调用 lark-cli 写入 Sheets 或 Base。",
            "keywords": ["填表", "飞书表格", "电子表格", "多维表格", "写入飞书"],
            "toolAllowlist": ["load_skill", "read_skill_resource", "run_skill_script", "feishu.query_bitable", "feishu.draft_bitable_record"],
            "requiredSkills": ["lark-sheet-fill"]
          },
          {
            "id": "analysis-report",
            "label": "运营分析报告",
            "description": "把已经验证的分析组织为结论、证据、限制和行动项一致的运营报告。",
            "keywords": ["分析报告", "经营复盘", "周报", "月报", "汇报", "管理摘要"],
            "toolAllowlist": ["search_knowledge", "calculate"],
            "requiredSkills": ["data-report-method", "business-insight-report"]
          }
        ]
      }
    }
  }
}
